cat > .gitignore << 'EOF'
# ========================
# ROS 2 / colcon 构建产物
# ========================
build/
install/
log/

# ========================
# C++ 编译中间文件 (CMake)
# ========================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ========================
# Python 相关 (ROS2 Python节点)
# ========================
__pycache__/
*.pyc
*.egg-info/
dist/
*.egg

# ========================
# IDE / 编辑器配置
# ========================
# VS Code
.vscode/
# PyCharm / IntelliJ
.idea/
# Vim / Emacs 临时文件
*.swp
*~

# ========================
# 系统垃圾文件
# ========================
*.tmp
*.log
EOF